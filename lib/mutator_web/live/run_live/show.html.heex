<div class="mx-auto max-w-5xl px-4 py-8">
  <.link href={~p"/runs"} class="text-sm text-sky-700 hover:underline">← all runs</.link>

  <div class="mt-2 flex items-center gap-3">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Run #{@run.id}</h1>
    <span class="rounded-full bg-sky-100 px-2 py-0.5 text-xs font-medium text-sky-800">
      {@run.state}
    </span>
    <button
      :if={@run.state in ~w(queued preparing baselining scanning running)}
      phx-click="cancel"
      class="rounded border border-amber-300 px-2 py-1 text-xs text-amber-800 hover:bg-amber-50"
    >
      cancel run
    </button>
  </div>

  <p class="mt-1 font-mono text-xs text-slate-500">{@run.source_path}</p>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <.stat label="Language" value={@run.language} />
    <.stat label="Score" value={score_display(@run)} emphasis />
    <.stat label="Sites" value={"#{@run.terminal_sites} / #{@run.selected_sites}"} />
    <.stat label="Baseline" value={"#{@run.baseline_ms || 0} ms"} />
  </div>

  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-5">
    <.stat label="Killed" value={@run.killed} />
    <.stat label="Survived" value={@run.survived} />
    <.stat label="Invalid" value={@run.invalid} />
    <.stat label="Errors" value={@run.error_count} />
    <.stat label="Cancelled" value={@run.cancelled_count} />
  </div>

  <div class="mt-4">
    <div class="h-2 w-full overflow-hidden rounded-full bg-slate-200">
      <div
        class="h-full rounded-full bg-sky-500 transition-all"
        style={"width: #{progress_percent(@run)}%"}
      >
      </div>
    </div>
    <p class="mt-1 text-right text-xs text-slate-500">{progress_percent(@run)}% terminal</p>
  </div>

  <p
    :if={@run.failure_reason}
    class="mt-4 rounded border border-rose-200 bg-rose-50 p-3 font-mono text-xs whitespace-pre-wrap text-rose-800"
  >
    {@run.failure_reason}
  </p>

  <h2 class="mt-8 text-lg font-semibold text-slate-900">Functions</h2>
  <div class="mt-2 overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead>
        <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
          <th class="px-4 py-2">File</th>
          <th class="px-4 py-2">Function</th>
          <th class="px-4 py-2 text-right">Killed</th>
          <th class="px-4 py-2 text-right">Survived</th>
          <th class="px-4 py-2 text-right">Invalid</th>
          <th class="px-4 py-2 text-right">Score</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <tr :for={f <- @functions}>
          <td class="px-4 py-2 font-mono text-xs text-slate-600">{f.file}</td>
          <td class="px-4 py-2 font-mono text-xs text-slate-900">{f.function}</td>
          <td class="px-4 py-2 text-right">{f.killed || 0}</td>
          <td class="px-4 py-2 text-right">{f.survived || 0}</td>
          <td class="px-4 py-2 text-right">{f.invalid || 0}</td>
          <td class="px-4 py-2 text-right font-semibold">{fn_score(f)}</td>
        </tr>
      </tbody>
    </table>
    <p :if={@functions == []} class="px-4 py-4 text-sm text-slate-500">
      No function results yet.
    </p>
  </div>

  <h2 class="mt-8 text-lg font-semibold text-slate-900">Outcomes</h2>
  <div class="mt-2 max-h-[28rem] overflow-y-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead class="sticky top-0 bg-white">
        <tr class="text-left text-xs uppercase tracking-wide text-slate-500">
          <th class="px-4 py-2">Site</th>
          <th class="px-4 py-2">Mutation</th>
          <th class="px-4 py-2">Status</th>
          <th class="px-4 py-2">Reason</th>
          <th class="px-4 py-2 text-right">Elapsed</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <tr :for={o <- @outcomes}>
          <td class="px-4 py-1.5 font-mono text-xs text-slate-500">
            {o.site.file}:{o.site.line} ({o.site.function})
          </td>
          <td class="px-4 py-1.5 font-mono text-xs">
            <span class="rounded bg-slate-100 px-1">{o.site.original}</span>
            → <span class="rounded bg-slate-900 px-1 text-white">{o.site.replacement}</span>
          </td>
          <td class="px-4 py-1.5">
            <.status_badge status={o.status} />
          </td>
          <td class="px-4 py-1.5 text-xs text-slate-600">{o.reason}</td>
          <td class="px-4 py-1.5 text-right text-xs text-slate-500">{o.elapsed_ms || "-"} ms</td>
        </tr>
      </tbody>
    </table>
    <p :if={@outcomes == []} class="px-4 py-4 text-sm text-slate-500">No outcomes yet.</p>
  </div>

  <details class="mt-6">
    <summary class="cursor-pointer text-sm text-slate-600">Test command</summary>
    <pre class="mt-2 rounded bg-slate-900 p-3 text-xs text-slate-100"><%= Enum.join(@run.test_argv, " ") %></pre>
  </details>
</div>
